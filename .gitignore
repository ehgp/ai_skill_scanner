__pycache__
.omc
.claude

# Env files: deny by default at any depth; only templates are tracked.
.env
.env.*
*.env
!.env.example
!.env.*.example

# Scan working data (directory skeletons kept via .gitkeep)
candidates/*
!candidates/.gitkeep
approved/*
!approved/.gitkeep
rejected/*
!rejected/.gitkeep
reports/*
!reports/.gitkeep

# Generated by update-scanners.py
scanner-pins.json

# Radar local state (radar.py); radar/SOURCES.md stays tracked
radar/snapshots/
radar/state.json
radar/candidates.yaml
