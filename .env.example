# Copy to .env and fill in. Every var the scanner reads is listed here;
# a var already set in the real environment always wins over .env.

# --- Snyk (snyk-agent-scan stage + snyk CLI SCA/SAST stages) ---
# Without it, snyk_agent_scan is skipped for skills/plugins and MCP artifacts
# are REJECTED as unverifiable.
SNYK_TOKEN=

# --- Cisco skill-scanner LLM analyzer (only used with --llm / settings.llm) ---
# The wrapper maps CISCO_* names onto the tool's native names. When these are
# left empty but OPENAI_API_KEY + OPENAI_BASE_URL are set, Cisco's LLM
# analyzer automatically uses that local OpenAI-compatible endpoint
# (provider openai-compatible, model from SKILLSPECTOR_MODEL).
CISCO_SKILL_SCANNER_LLM_API_KEY=
# For LLM analyzer and Meta-analyzer
CISCO_SKILL_SCANNER_LLM_MODEL=
# CISCO_SKILL_SCANNER_LLM_BASE_URL=
# CISCO_SKILL_SCANNER_LLM_PROVIDER=openai-compatible

# --- Cisco optional cloud analyzers (enabled automatically when key is set) ---
# For VirusTotal hash/binary scanning (native: VIRUSTOTAL_API_KEY)
CISCO_VIRUSTOTAL_API_KEY=
# For Cisco AI Defense cloud analysis (native: AI_DEFENSE_API_KEY)
CISCO_AI_DEFENSE_API_KEY=

# --- NVIDIA SkillSpector LLM analyzer (only used with --llm / settings.llm) ---
# Provider: openai | anthropic | bedrock | nv_build | claude_cli | codex_cli
# claude_cli / codex_cli use local CLI auth and need no API key.
SKILLSPECTOR_PROVIDER=
OPENAI_API_KEY=
OPENAI_BASE_URL=
SKILLSPECTOR_MODEL=
# CA bundle path for TLS verification on requests hitting a local /
# self-hosted LLM endpoint. Passed through the environment untouched.
requestOptionscaBundlePathdata=
ANTHROPIC_API_KEY=
NVIDIA_INFERENCE_KEY=

# --- Upstream scanner version pins (defaults are the verified latest) ---
# CISCO_SKILL_SCANNER_VERSION=2.0.13
# SKILLSPECTOR_GIT_REF=v2.8.2
# SNYK_AGENT_SCAN_VERSION=0.5.16
